        (setf (leetcode-anki--session-state session) state)
        (should-error (leetcode-anki-next-force) :type 'user-error)))
    (should-not actions)
    (should-not answers)))

(ert-deftest leetcode-anki-force-next-reopens-an-inactive-unfinished-review ()
