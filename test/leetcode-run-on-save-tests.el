;;; leetcode-run-on-save-tests.el --- Test solutions on save -*- lexical-binding: t; -*-

(require 'ert)
(require 'leetcode)

(ert-deftest leetcode-run-on-save-follows-setting-and-mode ()
  (let* ((root (make-temp-file "leetcode-run-on-save-" t))
         (file (expand-file-name "solution.py" root))
         (buffer (find-file-noselect file))
         (unrelated (generate-new-buffer " *leetcode-unrelated*"))
         (leetcode-run-on-save t)
         (calls 0)
         (saved-content nil)
         (tested-buffer nil))
    (unwind-protect
        (cl-letf (((symbol-function 'leetcode-try)
                   (lambda ()
                     (cl-incf calls)
                     (setq tested-buffer (current-buffer))
                     (with-temp-buffer
                       (insert-file-contents file)
                       (setq saved-content (buffer-string)))
                     (let ((promise (aio-promise)))
                       (aio-resolve promise (lambda () nil))
                       promise))))
          (with-current-buffer buffer
            (leetcode-solution-mode 1)
            (leetcode-solution-mode 1)
            (should (local-variable-p 'auto-save-visited-mode))
            (should-not auto-save-visited-mode)
            (should-not auto-save-default)
            (should-not buffer-auto-save-file-name)
            (insert "first save\n")
            (save-buffer)
            (should (= calls 1))
            (should (eq tested-buffer buffer))
            (should (equal saved-content "first save\n"))
            (let ((leetcode-run-on-save nil))
              (insert "disabled setting\n")
              (save-buffer))
            (should (= calls 1))
            (leetcode-solution-mode -1)
            (should-not (local-variable-p 'auto-save-visited-mode))
            (should-not (local-variable-p 'auto-save-default))
            (insert "disabled mode\n")
            (save-buffer)
            (should (= calls 1)))
          (with-current-buffer unrelated
            (should-not (memq #'leetcode--run-after-save after-save-hook))))
      (dolist (candidate (list buffer unrelated))
        (when (buffer-live-p candidate)
          (with-current-buffer candidate (set-buffer-modified-p nil))
          (kill-buffer candidate)))
      (delete-directory root t))))

(ert-deftest leetcode-run-on-save-failure-does-not-prevent-saving ()
  (with-temp-buffer
    (let ((leetcode-run-on-save t))
      (leetcode-solution-mode 1)
      (cl-letf (((symbol-function 'leetcode-try) (lambda () (error "Network unavailable"))))
        (leetcode--run-after-save)))))

(provide 'leetcode-run-on-save-tests)
;;; leetcode-run-on-save-tests.el ends here
