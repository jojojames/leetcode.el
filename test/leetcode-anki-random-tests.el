;;; leetcode-anki-random-tests.el --- Random practice selection -*- lexical-binding: t; -*-
(require 'ert)
(require 'leetcode-anki)

(defun leetcode-anki-random-test--card (id slug topic)
  `((cardId . ,id) (deckName . ,(concat "LeetCode::NeetCode150::" topic))
    (fields (slug (value . ,slug)))))

(ert-deftest leetcode-anki-random-prefers-another-topic-without-reviewer-actions ()
  (let* ((leetcode-anki--active
          (leetcode-anki--make-session :card-id 1 :slug "current" :deck "LeetCode::NeetCode150::01 Arrays"))
         (cards (list (leetcode-anki-random-test--card 1 "current" "01 Arrays")
                      (leetcode-anki-random-test--card 2 "other-array" "01 Arrays")
                      (leetcode-anki-random-test--card 3 "tree" "07 Trees")))
         calls)
    (cl-letf (((symbol-function 'leetcode-anki--request)
               (lambda (action &optional params)
                 (push action calls)
                 (pcase action
                   ("findCards" (should (equal (alist-get 'query params) "deck:\"LeetCode::NeetCode150\" is:new -is:suspended -is:buried")) '(1 2 3))
                   ("cardsInfo" cards)
                   (_ (ert-fail "Random selection must not mutate Anki")))))
              ((symbol-function 'random) (lambda (_) 0)))
      (should (= (alist-get 'cardId (leetcode-anki--random-card "LeetCode::NeetCode150")) 3))
      (should (equal (reverse calls) '("findCards" "cardsInfo"))))))

(ert-deftest leetcode-anki-random-subdeck-stays-in-scope-and-excludes-active-problem ()
  (let* ((leetcode-anki--active
          (leetcode-anki--make-session :card-id 1 :slug "current" :deck "LeetCode::NeetCode150::01 Arrays"))
         (cards (list (leetcode-anki-random-test--card 1 "current" "01 Arrays")
                      (leetcode-anki-random-test--card 2 "other-array" "01 Arrays")
                      (leetcode-anki-random-test--card 3 "tree" "07 Trees"))))
    (cl-letf (((symbol-function 'leetcode-anki--request)
               (lambda (action &optional _)
                 (pcase action ("findCards" '(1 2 3)) ("cardsInfo" cards)
                        (_ (ert-fail "Unexpected action")))))
              ((symbol-function 'random) (lambda (_) 0)))
      (should (= (alist-get 'cardId (leetcode-anki--random-card "LeetCode::NeetCode150::01 Arrays")) 2))
      (setq cards (list (car cards)))
      (should-error (leetcode-anki--random-card "LeetCode::NeetCode150::01 Arrays") :type 'user-error))))

(ert-deftest leetcode-anki-random-selects-topics-uniformly-before-problems ()
  (let ((leetcode-anki--active nil)
        (cards (list (leetcode-anki-random-test--card 1 "a" "Arrays")
                     (leetcode-anki-random-test--card 2 "b" "Arrays")
                     (leetcode-anki-random-test--card 3 "c" "Trees")))
        sizes)
    (cl-letf (((symbol-function 'leetcode-anki--request)
               (lambda (action &optional _)
                 (pcase action ("findCards" '(1 2 3)) ("cardsInfo" cards))))
              ((symbol-function 'random) (lambda (size) (push size sizes) 0)))
      (leetcode-anki--random-card "LeetCode::NeetCode150")
      (should (equal (reverse sizes) '(2 1))))))

(ert-deftest leetcode-anki-random-starts-a-native-rescheduling-review ()
  (let* ((leetcode-anki--active nil)
         (leetcode-anki--selected-deck "LeetCode::NeetCode150")
         (card (leetcode-anki-random-test--card 456 "tree" "Trees"))
         (native (copy-tree card))
         actions opened)
    (setf (alist-get 'deckName native) "LeetCode Random")
    (cl-letf (((symbol-function 'leetcode-anki--wait-for-current-card) (lambda () nil))
              ((symbol-function 'leetcode-anki--random-card) (lambda (_) card))
              ((symbol-function 'leetcode-anki--request)
               (lambda (action &optional params)
                 (push action actions)
                 (should (equal action "leetcodeReviewRandomCard"))
                 (should (= (alist-get 'cardId params) 456))
                 (should (equal (alist-get 'deck params) leetcode-anki--selected-deck))
                 native))
              ((symbol-function 'leetcode-anki--open-card)
               (lambda (selected)
                 (should (equal selected native))
                 (setq opened t)
                 (let ((promise (aio-promise)))
                   (aio-resolve promise (lambda () t)) promise))))
      (aio-wait-for (leetcode-anki-next-force-random))
      (should opened)
      (should (equal actions '("leetcodeReviewRandomCard"))))))

(ert-deftest leetcode-anki-random-force-resumes-unfinished-attempt ()
  (let ((leetcode-anki--active (leetcode-anki--make-session :state 'solving))
        resumed)
    (cl-letf (((symbol-function 'leetcode-anki--request)
               (lambda (&rest _) (ert-fail "Must not replace an unfinished review")))
              ((symbol-function 'leetcode-anki-next) (lambda () (setq resumed t))))
      (leetcode-anki-next-force-random)
      (should resumed))))

(ert-deftest leetcode-anki-random-review-reopens-its-own-reviewer-before-rating ()
  (let* ((leetcode-anki--selected-deck "LeetCode::NeetCode150")
         (ready nil)
         (card '((cardId . 456) (deckName . "LeetCode Random"))))
    (cl-letf (((symbol-function 'leetcode-anki--current-card) (lambda () (and ready card)))
              ((symbol-function 'leetcode-anki--require-success)
               (lambda (action &optional params)
                 (should (equal action "guiDeckReview"))
                 (should (equal (alist-get 'name params) "LeetCode Random"))
                 (setq ready t))))
      (should (equal (leetcode-anki--next-card "LeetCode Random") card)))))
